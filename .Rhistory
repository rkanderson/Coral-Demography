library(tidyverse)
library(here)
library(janitor)
library(readxl)
# Load the dataset in data folder: coral_raw_wide_2024.xlsx
coral_df <- read_excel(here("data", "coral_raw_wide_2024.xlsx")) %>%
clean_names()
coral_df_long_2019 <- read_csv(here("data", "coral_raw_long_2019.csv")) %>%
clean_names()
# LTER1BR_Dyn_finishedX <- read_excel(here("data", "LTER1BR_Dyn_finishedX.xlsx")) %>%
#   clean_names()
#
# LTER1OR_Dyn_finishedX <- read_excel(here("data", "LTER1OR_Dyn_finishedX.xlsx")) %>%
#   clean_names()
distinct(coral_df$note_2013)
distinct(coral_df, note_2013)
distinct(coral_df, note_2014)
distinct(coral_df, note_2015)
distinct(coral_df, note_2016)
distinct(coral_df, note_2017)
distinct(coral_df, note_2018)
distinct(coral_df, note_2019)
distinct(coral_df, note_2020)
# Get all the column names that begin with "note" and get the distinct values
coral_df_long_2019 %>%
select(starts_with("note")) %>%
pivot_longer(cols = everything(), names_to = "note", values_to = "value") %>%
distinct(value) %>%
pull(value)
# For coral_df, get all the column names that begin with "note".
# Get the distinct values across all of these columns.
note_cols <- coral_df %>%
select(starts_with("note")) %>%
gather() %>%
distinct() %>%
pull()
note_cols
# For coral_df, get all the column names that begin with "note".
# Get the distinct values across all of these columns.
# make all lowercase.
note_vals <- coral_df %>%
select(starts_with("note")) %>%
gather() %>%
distinct() %>%
pull() %>%
tolower()
note_vals
# Some of these values are actually multiple values separated by commas
# extract these values and consider them separately
note_vals <- note_vals %>%
str_split(",") %>%
unlist() %>%
str_trim() %>%
unique()
note_vals
# Get all the values thath start with "fu"
note_vals %>%
str_subset("^fu")
note_vals %>%
str_subset("^fi")
# Get all the values thath start with "fu"
# consolidate anything that is the pattern "fu1, fu2, fu3, ..." into just "fuX"
note_vals %>%
str_subset("^fu") %>%
str_replace_all("fu[0-9]+", "fuX")
# Get all the values thath start with "fu"
# consolidate anything that is the pattern "fu1, fu2, fu3, ..." into just "fuX"
note_vals %>%
str_subset("^fu") %>%
str_replace_all("fu[0-9]+", "fuX") %>%
unique()
# Get all values that start with "fi"
note_vals %>%
str_subset("^fi") %>%
str_replace_all("fi[0-9]+", "fiX") %>%
unique()
# Get all the values thath start with "fu"
# consolidate anything that is the pattern "fu1, fu2, fu3, ..." into just "fuX"
note_vals %>%
str_subset("^fu") %>%
str_replace_all("fu[0-9]+", "fuX") %>%
unique()
# Get all values that start with "fi"
note_vals %>%
str_subset("^fi") %>%
str_replace_all("fi[0-9]+", "fiX") %>%
unique()
# Get all values that contain "fi"
note_vals %>%
str_subset("fi") %>%
unique()
# Get all values that start with "fi"
note_vals %>%
str_subset("^fi") %>%
str_replace_all("fi[0-9]+", "fiX") %>%
unique()
# Get all values that contain "fi"
note_vals %>%
str_subset("fi") %>%
unique()
# For coral_df, get all the column names that begin with "note".
# Get the distinct values across all of these columns.
# make all lowercase.
# remove any "\"" escape characters
note_vals <- coral_df %>%
select(starts_with("note")) %>%
gather() %>%
distinct() %>%
pull() %>%
tolower() %>%
str_replace_all("\"", "")
# Some of these values are actually multiple values separated by commas
# extract these values and consider them separately
note_vals <- note_vals %>%
str_split(",") %>%
unlist() %>%
str_trim() %>%
unique()
# Get all the values thath start with "fu"
# consolidate anything that is the pattern "fu1, fu2, fu3, ..." into just "fuX"
note_vals %>%
str_subset("^fu") %>%
str_replace_all("fu[0-9]+", "fuX") %>%
unique()
# Get all values that contain "fi"
note_vals %>%
str_subset("fi") %>%
unique()
# Get all the values thath start with "fu"
# consolidate anything that is the pattern "fu1, fu2, fu3, ..." into just "fuX"
note_vals %>%
str_subset("^fu") %>%
str_replace_all("fu[0-9]+", "fuX") %>%
unique()
# Get all values that start with "fi"
note_vals %>%
str_subset("^fi") %>%
str_replace_all("fi[0-9]+", "fiX") %>%
unique()
