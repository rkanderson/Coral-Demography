coral_df_long_2019 <- read_csv(here("data", "coral_raw_long_2019.csv")) %>%
clean_names()
# Make a plot showing relationship between width and height fields in coral_df_long_2019
ggplot(coral_df_long_2019, aes(x = width, y = length)) +
geom_point() +
labs(title = "Relationship between width and height of corals",
x = "Width",
y = "Length")
# Make a plot showing relationship between width and length fields in coral_df_long_2019
ggplot(coral_df_long_2019, aes(x = width, y = length, color = species)) +
geom_point() +
labs(title = "Relationship between width and length of corals",
x = "Width",
y = "Length")
# Make a plot showing relationship between width and length fields in coral_df_long_2019
ggplot(coral_df_long_2019, aes(x = width, y = length, color = taxa)) +
geom_point() +
labs(title = "Relationship between width and length of corals",
x = "Width",
y = "Length")
# Make a plot showing relationship between width and length fields in coral_df_long_2019
# also graph a y = x line
ggplot(coral_df_long_2019, aes(x = width, y = length, color = taxa)) +
geom_point() +
labs(title = "Relationship between width and length of corals",
x = "Width",
y = "Length") +
geom_abline(intercept = 0, slope = 1)
# Make a plot showing relationship between width and length fields in coral_df_long_2019
# also graph a y = x line
ggplot(coral_df_long_2019, aes(x = width, y = length, color = taxa)) +
geom_point(size = 0.5, alpha = 0.5) +
labs(title = "Relationship between width and length of corals",
x = "Width",
y = "Length") +
geom_abline(intercept = 0, slope = 1)
