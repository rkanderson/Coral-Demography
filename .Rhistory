library(tidyverse)
library(here)
library(janitor)
coral_df <- read_csv(here("data", "MCR_LTER_Lenihan_mapped_corals_20220413.csv"))
View(coral_df)
summary(coral_df)
# plot the heights
coral_df %>%
ggplot(aes(x = height_cm)) +
geom_histogram(bins = 30) +
labs(title = "Height of Coral Colonies",
x = "Height (cm)",
y = "Count")
